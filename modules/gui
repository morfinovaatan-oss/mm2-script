		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = Frame,
	})

	local function set(newState, silent)
		state = newState
		Utility.Tween(Switch, {BackgroundColor3 = state and Theme.Accent or Theme.ContainerDark}, 0.15)
		Utility.Tween(Knob, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)}, 0.15)
