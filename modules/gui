		set(not state)
	end)

	if opts.Default then
		set(true, true)
	end

	return {
		Frame = Frame,
		Set = set,
		Get = function() return state end,
	}
end

--// SLIDER
function Groupbox:AddSlider(opts)
	opts = opts or {}
	local min = opts.Min or 0
	local max = opts.Max or 100
	local step = opts.Step or 1
	local value = math.clamp(opts.Default or min, min, max)
	local suffix = opts.Suffix or "%"

	local Frame = widgetFrame(self.Body, 46)

	Utility.Create("TextLabel", {
		Size = UDim2.new(1, -110, 0, 20),
		Position = UDim2.new(0, 12, 0, 4),
		BackgroundTransparency = 1,
		Text = opts.Text or "Slider",
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = Frame,
	})

	-- Кнопка "-"
	local MinusBtn = Utility.Create("TextButton", {
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(1, -96, 0, 5),
		BackgroundColor3 = Theme.ContainerDark,
		AutoButtonColor = false,
		Text = "-",
		TextColor3 = Theme.SubText,
		Font = Theme.FontBold,
		TextSize = 14,
		Parent = Frame,
	})
	Utility.Corner(MinusBtn, 4)

	local ValueLabel = Utility.Create("TextLabel", {
		Size = UDim2.new(0, 44, 0, 20),
		Position = UDim2.new(1, -74, 0, 4),
		BackgroundTransparency = 1,
		Text = tostring(value) .. suffix,
		TextColor3 = Theme.Accent,
		Font = Theme.FontBold,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = Frame,
	})

	-- Кнопка "+"
	local PlusBtn = Utility.Create("TextButton", {
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(1, -26, 0, 5),
		BackgroundColor3 = Theme.ContainerDark,
		AutoButtonColor = false,
		Text = "+",
		TextColor3 = Theme.SubText,
		Font = Theme.FontBold,
		TextSize = 14,
		Parent = Frame,
	})
	Utility.Corner(PlusBtn, 4)

	local Track = Utility.Create("Frame", {
		Size = UDim2.new(1, -24, 0, 6),
		Position = UDim2.new(0, 12, 0, 32),
		BackgroundColor3 = Theme.ContainerDark,
		BorderSizePixel = 0,
		Parent = Frame,
	})
	Utility.Corner(Track, 3)

	local Fill = Utility.Create("Frame", {
		Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Parent = Track,
	})
	Utility.Corner(Fill, 3)

	local Grip = Utility.Create("Frame", {
		Size = UDim2.new(0, 12, 0, 12),
		Position = UDim2.new((value - min) / (max - min), -6, 0.5, -6),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = Track,
	})
	Utility.Corner(Grip, 6)

	local dragging = false

	local function setValue(v, silent)
		v = math.clamp(math.floor(v + 0.5), min, max)
		value = v
		local alpha = (v - min) / (max - min)
		Utility.Tween(Fill, {Size = UDim2.new(alpha, 0, 1, 0)}, 0.05)
		Utility.Tween(Grip, {Position = UDim2.new(alpha, -6, 0.5, -6)}, 0.05)
		ValueLabel.Text = tostring(v) .. suffix
		if not silent and opts.Callback then
			task.spawn(opts.Callback, v)
		end
	end

	local function updateFromInput(inputPos)
		local rel = (inputPos.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
		rel = math.clamp(rel, 0, 1)
		setValue(min + (max - min) * rel)
	end

	Track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			updateFromInput(input.Position)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromInput(input.Position)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	MinusBtn.MouseButton1Click:Connect(function()
		setValue(value - step)
	end)
	PlusBtn.MouseButton1Click:Connect(function()
		setValue(value + step)
	end)

	for _, btn in ipairs({MinusBtn, PlusBtn}) do
		btn.MouseEnter:Connect(function()
			Utility.Tween(btn, {BackgroundColor3 = Theme.ContainerDark:Lerp(Theme.Accent, 0.3)}, 0.15)
		end)
		btn.MouseLeave:Connect(function()
			Utility.Tween(btn, {BackgroundColor3 = Theme.ContainerDark}, 0.15)
		end)
	end

	setValue(value, true)

	return {
		Frame = Frame,
		Set = setValue,
		Get = function() return value end,
	}
end

--// DROPDOWN / COMBO
function Groupbox:AddDropdown(opts)
	opts = opts or {}
	local items = opts.Items or {}
	local multi = opts.Multi or false
	local selected = {}
	if opts.Default then
		if type(opts.Default) == "table" then
			for _, v in ipairs(opts.Default) do selected[v] = true end
		else
			selected[opts.Default] = true
		end
	end

	local Frame = widgetFrame(self.Body, 34)
	Frame.ClipsDescendants = false
	Frame.ZIndex = 5

	Utility.Create("TextLabel", {
		Size = UDim2.new(1, -50, 1, 0),
		Position = UDim2.new(0, 12, 0, 0),
		BackgroundTransparency = 1,
		Text = opts.Text or "Dropdown",
		TextColor3 = Theme.SubText,
		Font = Theme.Font,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = Frame,
	})

	local function currentText()
		local names = {}
		for _, item in ipairs(items) do
			if selected[item] then names[#names + 1] = item end
		end
		if #names == 0 then return "None" end
		return table.concat(names, ", ")
	end

	local SelectedLabel = Utility.Create("TextLabel", {
		Size = UDim2.new(0.6, -30, 1, 0),
		Position = UDim2.new(0.4, 0, 0, 0),
		BackgroundTransparency = 1,
		Text = currentText(),
		TextColor3 = Theme.Text,
		Font = Theme.Font,
		TextSize = 12,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = Frame,
	})

	local Chevron = Utility.Create("TextLabel", {
		Size = UDim2.new(0, 20, 1, 0),
		Position = UDim2.new(1, -24, 0, 0),
		BackgroundTransparency = 1,
		Text = "˅",
		TextColor3 = Theme.SubText,
		Font = Theme.FontBold,
		TextSize = 14,
		Parent = Frame,
	})

	local ClickArea = Utility.Create("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		Parent = Frame,
	})

	local ListFrame = Utility.Create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		Position = UDim2.new(0, 0, 1, 4),
		BackgroundColor3 = Theme.ContainerLight,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 10,
		Parent = Frame,
	})
	Utility.Corner(ListFrame, 6)
	Utility.Stroke(ListFrame, Color3.fromRGB(255, 255, 255), 1, 0.9)
	local ListLayout = Utility.ListLayout(ListFrame, Enum.FillDirection.Vertical, 2)
	Utility.Padding(ListFrame, 4)

	local optionButtons = {}

	local function refreshHighlight()
		for item, btn in pairs(optionButtons) do
			btn.BackgroundColor3 = selected[item] and Theme.Accent or Theme.ContainerLight
			btn.TextColor3 = selected[item] and Color3.fromRGB(10, 10, 10) or Theme.Text
		end
		SelectedLabel.Text = currentText()
	end

	for _, item in ipairs(items) do
		local OptBtn = Utility.Create("TextButton", {
			Size = UDim2.new(1, -8, 0, 26),
			BackgroundColor3 = Theme.ContainerLight,
			AutoButtonColor = false,
			Text = item,
			TextColor3 = Theme.Text,
			Font = Theme.Font,
			TextSize = 12,
			Parent = ListFrame,
		})
		Utility.Corner(OptBtn, 4)
		optionButtons[item] = OptBtn

		OptBtn.MouseButton1Click:Connect(function()
			if multi then
				selected[item] = not selected[item] or nil
			else
				selected = {[item] = true}
			end
			refreshHighlight()
			if opts.Callback then
				local out = {}
				for _, i in ipairs(items) do if selected[i] then out[#out + 1] = i end end
				task.spawn(opts.Callback, multi and out or (out[1]))
			end
		end)
	end

	refreshHighlight()

	local open = false
	ClickArea.MouseButton1Click:Connect(function()
		open = not open
		ListFrame.Visible = true
		local targetHeight = open and (#items * 28 + 8) or 0
		Utility.Tween(ListFrame, {Size = UDim2.new(1, 0, 0, targetHeight)}, 0.15)
		Utility.Tween(Chevron, {Rotation = open and 180 or 0}, 0.15)
		if not open then
			task.delay(0.15, function() ListFrame.Visible = false end)
		end
	end)

	return {
		Frame = Frame,
		Get = function() return selected end,
	}
end

