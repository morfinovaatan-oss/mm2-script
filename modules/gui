-- TAB
--=========================================================================
local Tab = {}
Tab.__index = Tab

function UILibrary:AddTab(name, icon)
	local Window = self

	local Page = Utility.Create("Frame", {
		Name = name,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = Window.ContentHolder,
	})

	local TabButton = Utility.Create("TextButton", {
		Name = name,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Theme.Container,
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Parent = Window.TabListHolder,
	})
	Utility.Corner(TabButton, 6)

	local Icon = Utility.Create("ImageLabel", {
		Size = UDim2.new(0, 16, 0, 16),
		Position = UDim2.new(0, 10, 0.5, -8),
		BackgroundTransparency = 1,
		Image = icon or "",
		ImageColor3 = Theme.SubText,
		Parent = TabButton,
	})

	local Label = Utility.Create("TextLabel", {
		Size = UDim2.new(1, -40, 1, 0),
		Position = UDim2.new(0, 36, 0, 0),
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = Theme.SubText,
		Font = Theme.Font,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = TabButton,
	})

	local self = setmetatable({}, Tab)
	self.Window       = Window
	self.Name         = name
	self.Page         = Page
	self.Button       = TabButton
	self.Icon         = Icon
	self.Label        = Label
	self.SubTabs      = {}
	self.ActiveSubTab = nil

	Window.Tabs[#Window.Tabs + 1] = self
	Window.TabButtons[name] = TabButton

	local function selectTab()
		for _, t in ipairs(Window.Tabs) do
			t.Page.Visible = false
			Utility.Tween(t.Button, {BackgroundTransparency = 1}, 0.15)
			Utility.Tween(t.Icon, {ImageColor3 = Theme.SubText}, 0.15)
			Utility.Tween(t.Label, {TextColor3 = Theme.SubText}, 0.15)
		end
		Page.Visible = true
		Utility.Tween(TabButton, {BackgroundTransparency = 0}, 0.15)
		Utility.Tween(Icon, {ImageColor3 = Theme.Accent}, 0.15)
		Utility.Tween(Label, {TextColor3 = Theme.Text}, 0.15)
		Window.TabTitle.Text = name
		Window.ActiveTab = self

		-- перерисовать подвкладки в header
		for _, child in ipairs(Window.SubTabHolder:GetChildren()) do
			if child:IsA("GuiObject") then
				child.Parent = nil
			end
		end
		for _, sub in ipairs(self.SubTabs) do
			sub.HeaderButton.Parent = Window.SubTabHolder
		end
		if self.ActiveSubTab then
			self.ActiveSubTab:Select()
		elseif self.SubTabs[1] then
			self.SubTabs[1]:Select()
		end
	end

	TabButton.MouseButton1Click:Connect(selectTab)
	self.Select = selectTab

	TabButton.MouseEnter:Connect(function()
		if Window.ActiveTab ~= self then
			Utility.Tween(TabButton, {BackgroundTransparency = 0.7}, 0.15)
		end
	end)
	TabButton.MouseLeave:Connect(function()
		if Window.ActiveTab ~= self then
			Utility.Tween(TabButton, {BackgroundTransparency = 1}, 0.15)
		end
	end)

	-- Если это первая вкладка — выбрать автоматически
	if #Window.Tabs == 1 then
		selectTab()
	end

	return self
end

