	self.Tab          = ThisTab
	self.Name         = name
	self.Page         = Page
	self.HeaderButton = HeaderButton
	self.HeaderLabel  = HeaderLabel
	self.Underline    = Underline
	self.Groupboxes   = {}

	ThisTab.SubTabs[#ThisTab.SubTabs + 1] = self

	local function select()
		for _, s in ipairs(ThisTab.SubTabs) do
			s.Page.Visible = false
			Utility.Tween(s.HeaderLabel, {TextColor3 = Theme.SubText}, 0.15)
